#!/usr/bin/env bash
# ==============================================================================
# liferaft — The Minimalist Linux Backup Automation Engine
# "When your NVMe goes down with the ship, you don't file Jira tickets.
#  You deploy the liferaft."
# ==============================================================================

set -euo pipefail

# Locate project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Source config and core modules
# shellcheck source=../config/liferaft.conf
source "${PROJECT_ROOT}/config/liferaft.conf"
# shellcheck source=../lib/logger.sh
source "${PROJECT_ROOT}/lib/logger.sh"
# shellcheck source=../lib/archive.sh
source "${PROJECT_ROOT}/lib/archive.sh"
# shellcheck source=../lib/retention.sh
source "${PROJECT_ROOT}/lib/retention.sh"

# Trap ERR signals for immediate logging and clean up
trap 'handle_error $LINENO "${BASH_COMMAND:-unknown}"' ERR

# ------------------------------------------------------------------------------
# Banner
# ------------------------------------------------------------------------------
show_banner() {
    echo -e "${COLOR_INFO}"
    cat << "EOF"
  _      _  __                 __ _   
 | |    (_)/ _|               / _| |  
 | |     _| |_ ___ _ __ __ _ | |_| |_ 
 | |    | |  _/ _ \ '__/ _` ||  _| __|
 | |____| | ||  __/ | | (_| || | | |_ 
 |______|_|_| \___|_|  \__,_||_|  \__|
  Automated Linux Backup & Resilience System
EOF
    echo -e "${COLOR_RESET}"
}

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -r, --run       Run standard backup and retention pipeline (default)"
    echo "  -l, --list      List current archives in backup vault"
    echo "  -t, --toc       Inspect Table of Contents of newest archive (tar -tzf)"
    echo "  -h, --help      Display this help menu"
    exit 0
}

list_archives() {
    log_msg "INFO" "Vault repository contents (${BACKUP_DEST}):"
    if [[ ! -d "$BACKUP_DEST" ]]; then
        echo "  [Vault does not exist at $BACKUP_DEST]"
        return 0
    fi
    ls -lh "$BACKUP_DEST"/*.${COMPRESSION_EXT} 2>/dev/null || echo "  [No archives present]"
}

inspect_newest() {
    local newest
    newest="$(find "$BACKUP_DEST" -maxdepth 1 -name "${ARCHIVE_PREFIX}-*.${COMPRESSION_EXT}" 2>/dev/null | sort -r | head -n 1 || true)"
    if [[ -z "$newest" || ! -f "$newest" ]]; then
        log_msg "ERROR" "No archives found in ${BACKUP_DEST} to inspect."
        exit 1
    fi
    log_msg "INFO" "Inspecting archive Table of Contents (tar -tzf): $(basename "$newest")"
    echo "----------------------------------------------------------------------"
    tar -tzf "$newest" | head -n 25
    echo "... [truncated for brevity]"
    echo "----------------------------------------------------------------------"
}

# ------------------------------------------------------------------------------
# Main Orchestration Loop
# ------------------------------------------------------------------------------
main() {
    local mode="run"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage ;;
            -l|--list) mode="list"; shift ;;
            -t|--toc)  mode="toc"; shift ;;
            -r|--run)  mode="run"; shift ;;
            *) echo "Unknown option: $1"; usage ;;
        esac
    done

    if [[ "$mode" == "list" ]]; then
        list_archives
        exit 0
    fi

    if [[ "$mode" == "toc" ]]; then
        inspect_newest
        exit 0
    fi

    show_banner
    log_msg "INFO" "================ LIFERAFT RUN COMMENCING ================"

    # 1. Ensure destination directory exists
    if [[ ! -d "$BACKUP_DEST" ]]; then
        log_msg "WARN" "Destination $BACKUP_DEST missing. Attempting directory creation..."
        mkdir -p "$BACKUP_DEST"
        log_msg "INFO" "Created destination directory: $BACKUP_DEST"
    fi

    # 2. Build the Archive
    local timestamp
    timestamp="$(date +%Y-%m-%d_%H%M%S)"
    local archive_filename="${ARCHIVE_PREFIX}-${timestamp}.${COMPRESSION_EXT}"

    log_msg "INFO" "Initiating backup sequence for: ${BACKUP_SOURCES[*]}"
    create_archive "$BACKUP_DEST" "$archive_filename" "${BACKUP_SOURCES[@]}"

    # 3. Enforce Retention
    log_msg "INFO" "Enforcing ${RETENTION_DAYS}-day retention policy..."
    prune_stale_backups "$BACKUP_DEST" "$RETENTION_DAYS" "${ARCHIVE_PREFIX}-*.${COMPRESSION_EXT}"

    log_msg "SUCCESS" "Liferaft mission complete. All systems secure."
    log_msg "INFO" "=========================================================="
}

main "$@"
